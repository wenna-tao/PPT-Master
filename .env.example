# Server only. Leave blank for the fully usable manual workflow.
AI_PROVIDER=none
# Set AI_PROVIDER to gemini OR deepseek. Only the selected provider is called.
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# A private access code for invited testers. Never use an API key as this code.
PEACHWORKS_ACCESS_CODE=
# Optional fixed canonical origin, e.g. https://sprightly-druid-1da7ae.netlify.app
PEACHWORKS_ALLOWED_ORIGIN=

# Homework tutor only. All providers are OFF until explicitly enabled.
# These settings do not affect PPT's AI_PROVIDER (Gemini / DeepSeek only).
TUTOR_ENABLED=false
# Free trial uses the server-only trial code; after trial use a random access code.
TUTOR_TRIAL_MODE=true
TUTOR_TRIAL_ACCESS_CODE=
TUTOR_ACCESS_CODE=
# Separate owner code (32+ characters); never share it with guests.
TUTOR_ADMIN_ACCESS_CODE=
# Use a model ID available in your own provider account. No default model is chosen.
# Set VISION=true only after confirming that specific model supports image inputs.
TUTOR_DEEPSEEK_ENABLED=false
TUTOR_DEEPSEEK_API_KEY=
TUTOR_DEEPSEEK_MODEL=
TUTOR_DEEPSEEK_VISION=false
TUTOR_DEEPSEEK_DAILY_LIMIT=10
TUTOR_GEMINI_ENABLED=false
TUTOR_GEMINI_API_KEY=
TUTOR_GEMINI_MODEL=
TUTOR_GEMINI_VISION=false
TUTOR_GEMINI_DAILY_LIMIT=10
